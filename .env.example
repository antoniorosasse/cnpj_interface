# ============================================================
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o .env de verdade.
# ============================================================

# Django
SECRET_KEY=troque-por-uma-chave-secreta-longa
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens confiaveis para POST com CSRF (Django 4+), separadas por virgula.
# Em producao: https://cnpj.arosasse.tech,https://chat.arosasse.tech
CSRF_TRUSTED_ORIGINS=

# Django DB (django_internal, Postgres)
DJANGO_DB=django_internal
DJANGO_DB_USER=django_app
DJANGO_DB_PASSWORD=sua_senha
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# AS/400 (DB2)
AS400_HOST=pub400.com
AS400_USER=seu_usuario
AS400_PASSWORD=sua_senha
AS400_LIBRARY=SUA_LIBRARY
AS400_JDBC_JAR=/caminho/absoluto/para/lib/jt400.jar

# PostgreSQL (bancocnpj, dados da RFB, read-only para o chat)
PG_HOST=localhost
PG_PORT=5432
PG_DB=bancocnpj
PG_USER=arosasse
PG_PASSWORD=sua_senha

# Chat IA (usuario read-only chat_ia)
CHAT_PG_HOST=localhost
CHAT_PG_PORT=5432
CHAT_PG_DB=bancocnpj
CHAT_PG_USER=chat_ia
CHAT_PG_PASSWORD=sua_senha
CHAT_SQL_TIMEOUT=10
CHAT_SQL_MAX_ROWS=1000

# Backend do historico do chat: 0 = Postgres (padrao), 1 = MongoDB
# (lido em chat/repo.py no import; em producao o VPS usa 1)
CHAT_USE_MONGO=0

# DeepSeek (chat IA)
DEEPSEEK_API_KEY=sua_chave_aqui
CHAT_DEEPSEEK_MODEL=deepseek-chat
CHAT_DEEPSEEK_BASE_URL=https://api.deepseek.com

# MongoDB (opcional)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=cnpj
MONGO_USER=seu_usuario
MONGO_PASSWORD=sua_senha
